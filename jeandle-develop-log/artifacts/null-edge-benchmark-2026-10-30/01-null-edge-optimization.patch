+/// of its definition are the same chain, and a chain walk is the expensive
+/// part of the null-edge path.
+NullEdgePreFilter::BlockState
+NullEdgePreFilter::blockState(Value *V, BasicBlock *From, DominatorTree &DT) {
+  this->DT = &DT;
+  BlockState State;
+  if (!V || !From)
+    return State;
